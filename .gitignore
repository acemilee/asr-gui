# --- Local working data
# Archived upstream apps / model caches / run outputs (moved out of the repo root)
# Everything under _local/ (archived upstream app, model cache, run outputs,
# upstream source clone) is machine-local and must never be committed.
_local/
# Audio downloaded from video URLs ("视频链接" source) while testing.
downloads/

# The upstream portable app plus the 10 h test media live here; they are
# several GB and never belong in git.
workspace/
VideoToNo-1.4.6-portable/

